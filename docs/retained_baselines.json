  "required_tail_metrics": {
    "m2a": {
      "G2A.1": {
        "default": ["max_target_kt_bits"]
      },
      "G2A.2": {
        "default": ["max_target_kt_bits"]
      },
      "G2A.3": {
        "default": ["max_multi_lock_tick"]
      },
      "G2A.4": {
        "default": ["max_target_kt_bits"],
        "prefixes": {
          "G2A.4b:": ["max_target_kt_bits", "max_abs_kt_diff", "max_h_reactive_dev"]
        }
      },
      "G2A.5": {
        "default": ["min_kt_advantage"]
      }
    },
    "m2b": {
      "G2B.1": {
        "prefixes": {
          "G2B.1a:epistemic_mdl": ["max_epistemic_mdl_err"],
          "G2B.1a:starvation": ["max_starved_energy"],
          "G2B.1b:": ["max_target_kt_bits"]
        }
      },
      "G2B.2": {
        "default": ["min_target_comps", "min_settled_comp_ticks"]
